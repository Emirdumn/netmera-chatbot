GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
LOG_TOOL_CALLS=true
STAFF_DEMO_PASSWORD=replace-me-with-a-strong-random-staff-password

# Widget API (varsayilan KAPALI — acmadan once WIDGET_TOKEN_SECRET sart)
WIDGET_API_ENABLED=false
WIDGET_TOKEN_SECRET=
WIDGET_ALLOWED_ORIGINS=https://www.netmera.com
WIDGET_RATE_LIMIT_PER_MIN=20

# Personel paneli (Caddy Basic Auth) — bcrypt hash.
# Uretmek icin:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'PAROLA'
#
# ⚠ TUZAK: bcrypt hash '$' icerir ve Docker Compose bunu DEGISKEN sanar.
# Escape edilmezse hash konteynere BOZUK ulasir (sessizce kisalir) ve
# panele hicbir parolayla girilemez. Bu dosyaya yazarken her '$' iki kez
# yazilmali:  $2a$14$abc...  ->  $$2a$$14$$abc...
PANEL_PASSWORD_HASH=
