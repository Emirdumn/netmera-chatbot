GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
LOG_TOOL_CALLS=true

# Tier modelleri — bos birakilirsa OPENROUTER_MODEL / GEMINI_MODEL kullanilir.
# Kod mimarisi sabit; model isimleri operasyonel ayar (fiyat/latency degisir).
# CONTROL: domain / memory / orch / query rewrite / sentiment (ucuz, hizli)
# WORKER: grounded cevap, clarify, escalation ozeti (orta)
# BRAIN: sadece dusuk guven / celiskili routing (pahali, seyrek) — henuz
#         otomatik tetiklenmez; altyapi hazir, kural sonra eklenir.
LLM_CONTROL_MODEL=
LLM_WORKER_MODEL=
LLM_BRAIN_MODEL=
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_BRAIN_FALLBACK_TO_WORKER=true
LLM_TELEMETRY_ENABLED=true

STAFF_DEMO_PASSWORD=replace-me-with-a-strong-random-staff-password

# Widget API (varsayilan KAPALI — acmadan once WIDGET_TOKEN_SECRET sart)
# Canliya alma kontrolu: python scripts/widget_go_live_check.py
WIDGET_API_ENABLED=false
WIDGET_TOKEN_SECRET=
# Virgulle ayrilmis origin'ler. Pilot ornegi:
#   https://www.netmera.com,https://netmera-helpdesk.43.229.92.6.sslip.io
WIDGET_ALLOWED_ORIGINS=https://www.netmera.com
WIDGET_RATE_LIMIT_PER_MIN=20

# Fast RAG gate — guclu semantik eslesmede agir agent zincirine girmeden
# Netmera kaynaklarindan cevap uretir; zayif eslesmede LLM domain karari verir.
FAST_RAG_ENABLED=true
FAST_RAG_DIRECT_THRESHOLD=0.50
FAST_RAG_REWRITE_THRESHOLD=0.35

# Personel paneli (Caddy Basic Auth) — bcrypt hash.
# Uretmek icin:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'PAROLA'
#
# ⚠ TUZAK: bcrypt hash '$' icerir ve Docker Compose bunu DEGISKEN sanar.
# Escape edilmezse hash konteynere BOZUK ulasir (sessizce kisalir) ve
# panele hicbir parolayla girilemez. Bu dosyaya yazarken her '$' iki kez
# yazilmali:  $2a$14$abc...  ->  $$2a$$14$$abc...
PANEL_PASSWORD_HASH=
